# Default: let Git normalize text in the repository.
* text=auto

# These are executed by Linux, so they must be LF in the working tree as well
# as in the repository — not merely LF because a given clone happens to have
# core.autocrlf set. A CRLF release.sh fails on the VPS as
# "bash: $'\r': command not found" midway through a deploy, and a CRLF
# Dockerfile breaks RUN lines during the image build.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Generated by tools/make_icons.py — never line-ending-converted.
*.png           binary
*.xlsx          binary
