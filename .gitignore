# Dependencies & environments
node_modules/
.venv/

# Secrets — real keys live only in backend/.env (see backend/.env.example)
.env
.env.local
# Production secrets live on the VPS only; these names exist so a local copy
# made from deploy/*.example can never be committed by accident.
deploy/backend.env
deploy/web.env

# Build output & caches
.next/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Local databases
*.db
.claude/settings.local.json

# Build artifacts & run logs
*.tsbuildinfo
pipeline_run.log
*.bak
