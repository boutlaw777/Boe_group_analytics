# SEC requires a descriptive User-Agent including a contact email (see sec.gov fair-access policy)
SEC_USER_AGENT=FinClone/0.1 (mohsin@boegroup.com)

# SQLite for dev; use postgresql+psycopg://user:pass@host/dbname in production
DATABASE_URL=sqlite:///./finclone.db

# DeepSeek — Scout's provider, and the KPI/triage fallback when GEMINI_API_KEY
# below is unset (OpenAI-compatible API).
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Scout's model. Kept separate from FINCLONE_KPI_MODEL so routing KPI work to
# another provider can never send a foreign model name to DeepSeek's endpoint.
FINCLONE_SCOUT_MODEL=deepseek-chat

# Gemini — optional KPI-extraction provider (OpenAI-compatible endpoint). The
# bulk KPI sweep is thousands of calls, so it can run on Gemini's free tier
# instead of spending DeepSeek credit. Setting this reroutes KPI extraction,
# flag triage, and the M2 agents to Gemini; Scout stays on DeepSeek for low
# interactive latency. Leave blank to run everything on DeepSeek.
GEMINI_API_KEY=
KPI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model for KPI extraction. With GEMINI_API_KEY set this must be a Gemini model
# (gemini-flash-lite-latest works on the free key; gemini-2.0-flash and
# gemini-2.5-flash return 429/404). Otherwise deepseek-chat or deepseek-reasoner.
FINCLONE_KPI_MODEL=gemini-flash-lite-latest

# Scout fallback provider — retried once when DeepSeek fails with a quota,
# balance, rate-limit, or connection error. Deliberately its own variable, not
# a reuse of GEMINI_API_KEY: enabling this must not reroute KPI extraction.
# Ideally a different account from both of the above, so one exhausted balance
# or daily cap cannot take the primary and the fallback down together.
SCOUT_FALLBACK_GEMINI_API_KEY=
SCOUT_FALLBACK_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SCOUT_FALLBACK_GEMINI_MODEL=gemini-flash-lite-latest

# Cost control: max document chunks sent to the LLM per filing
FINCLONE_KPI_MAX_CHUNKS=6

# SimFin — cross-reference validation source (PDR §3)
SIMFIN_API_KEY=your-simfin-key

# Supabase Storage — raw-filing archive (fills the PDR's S3 role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
FINCLONE_ARCHIVE_BUCKET=filings

# API key enforcement (PDR Module 5)
FINCLONE_REQUIRE_API_KEY=false
FINCLONE_ADMIN_TOKEN=set-a-long-random-admin-token

# Flag values whose SEC vs reference variance exceeds this fraction (PDR: 1%)
FINCLONE_VARIANCE_THRESHOLD=0.01

# Validation-queue alerting. Without a webhook the queue holds items correctly
# but tells nobody, which is how the AAPL long-term-debt flags sat open across
# three fiscal years. Any Slack/Teams incoming webhook works; leave blank in dev
# and new items are logged to the sweep's own output instead.
FINCLONE_ALERT_WEBHOOK=
# Only push flags at least this far apart. The queue flags at 1% by design, and
# paging a human for a 1.2% rounding difference is how a channel gets muted.
FINCLONE_ALERT_MIN_VARIANCE=0.05
# Base URL used to build the "review this" link in an alert.
FINCLONE_WEB_BASE=http://localhost:3000

# Stripe billing (PDR Module 5) — self-serve tier upgrades.
# Leave STRIPE_SECRET_KEY blank to disable billing (the /billing endpoints then
# return 503 and the rest of the API is unaffected).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from the Stripe dashboard (Products → your pro/enterprise plans)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
# Where Stripe returns the user after checkout / billing portal (your web app)
FINCLONE_BILLING_SUCCESS_URL=http://localhost:3000/account?checkout=success
FINCLONE_BILLING_CANCEL_URL=http://localhost:3000/account?checkout=cancel
