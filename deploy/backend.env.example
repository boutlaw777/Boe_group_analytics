# Copy to backend.env ON THE VPS (never commit it, CI never writes it).
# Same variables as backend/.env.example — this lists what production needs.

SEC_USER_AGENT=BOE Analytics/1.0 (mohsin@boegroup.com)

# The existing managed Postgres. The app's tables live in the `boe` schema.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# LLM providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
FINCLONE_KPI_MODEL=gemini-flash-lite-latest

# Cross-reference + archive
SIMFIN_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
FINCLONE_ARCHIVE_BUCKET=filings

# Alerting for the validation queue
FINCLONE_ALERT_WEBHOOK=
FINCLONE_WEB_BASE=https://analytics.boegroup.com

# API gate. Leave false only if the API is meant to be public.
FINCLONE_REQUIRE_API_KEY=true
FINCLONE_ADMIN_TOKEN=

# Stripe. Blank STRIPE_SECRET_KEY disables /billing (503) without affecting
# the rest of the API.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
FINCLONE_BILLING_SUCCESS_URL=https://analytics.boegroup.com/developers/portal?checkout=success
FINCLONE_BILLING_CANCEL_URL=https://analytics.boegroup.com/developers/portal?checkout=cancel
