# Copy to web.env ON THE VPS (never commit it, CI never writes it).

# Host networking, so the API is on loopback rather than a compose service name.
FINCLONE_API=http://127.0.0.1:8100

# Required when the backend runs with FINCLONE_REQUIRE_API_KEY=true. Issue a
# key from the developer portal and paste it here — without it every server
# component renders its empty-state fallback.
FINCLONE_API_KEY=

NEXT_PUBLIC_DCF_BASE=https://dcf.boegroup.com
